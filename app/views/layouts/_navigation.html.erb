<nav class="navbar">
  <div class="nav-container">
    <div class="nav-brand">
      <%= link_to "🍽️ Restaurant Reservation", root_path, class: "brand-link" %>
    </div>
    
    <div class="nav-menu">
      <% if logged_in? %>
        <% if current_user.admin? %>
          <%= link_to "Dashboard", admin_dashboard_path, class: "nav-link" %>
          <%= link_to "📅 Calendar", admin_time_slots_calendar_path, class: "nav-link", title: "Availability Calendar - View booking availability" %>
          <%= link_to "📋 Schedule", admin_calendar_path, class: "nav-link", title: "Reservation Schedule - Manage existing bookings" %>
          <%= link_to "Reservations", admin_reservations_path, class: "nav-link" %>
          <%= link_to "Time Slots", admin_time_slots_path, class: "nav-link" %>
          <%= link_to "Tables", admin_tables_path, class: "nav-link" %>
        <% else %>
          <%= link_to "My Reservations", reservations_path, class: "nav-link" %>
          <%= link_to "New Reservation", new_reservation_path, class: "nav-link" %>
          <%= link_to "Availability", availability_reservations_path, class: "nav-link" %>
        <% end %>
        
        <div class="nav-user">
          <span class="user-name">👤 <%= current_user.name %></span>
          <%= button_to "Logout", logout_path, method: :delete, class: "btn btn-secondary btn-sm" %>
        </div>
      <% else %>
        <%= link_to "Login", login_path, class: "btn btn-primary" %>
        <%= link_to "Sign Up", signup_path, class: "btn btn-secondary" %>
      <% end %>
    </div>
  </div>
</nav>
