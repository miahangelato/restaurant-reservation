<% content_for :title, "New Reservation - Restaurant Reservation System" %>

<div class="page-header">
  <h1>Make a Reservation</h1>
  <div class="header-buttons">
    <%= link_to "📅 View Calendar", calendar_reservations_path, class: "btn btn-outline-secondary" %>
    <%= link_to "← Back to My Reservations", reservations_path, class: "btn btn-link" %>
  </div>
</div>

<div class="reservation-form-container">
  <% if current_user.nil? %>
    <div class="alert alert-info py-3 px-3" role="status" aria-live="polite">
      <div class="d-flex align-items-start gap-3">
        <span class="badge rounded-pill bg-primary text-white mt-1" aria-hidden="true">i</span>
        <div class="flex-grow-1">
          <strong class="d-block">You're booking as a guest</strong>
          <small class="text-muted">You'll get a one-time link by email to view this reservation. Guests cannot edit or cancel reservations.</small>
          <small class="text-muted d-block">Please make sure to double check all the information before proceeding.</small>
          <div class="mt-2">
            <%= link_to 'Create account', signup_path, class: 'btn btn-sm btn-primary me-2' %>
            <%= link_to 'Sign in', login_path, class: 'btn btn-sm btn-outline-secondary' %>
          </div>
        </div>

        <!-- Dismiss button removed per design: guests should see the banner until they navigate away -->
      </div>
    </div>
  <% end %>

  <%= form_with model: @reservation, class: "reservation-form", data: { controller: "reservations", turbo: false } do |f| %>
    <% if @reservation.errors.any? %>
      <div class="alert alert-danger">
        <h4><%= pluralize(@reservation.errors.count, "error") %> prevented this reservation from being saved:</h4>
        <ul>
          <% @reservation.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    
    <div class="form-row">
      <div class="form-group col-md-6">
        <%= f.label :reservation_date, "Date" %>
        <%= f.date_field :reservation_date, 
            class: "form-control", 
            min: @min_date, 
            max: @max_date,
            required: true,
            data: { action: "change->reservations#dateChanged", reservations_target: "dateField" } %>
        <small class="form-text">Reservations must be made at least 2 hours in advance</small>
      </div>
      
      <div class="form-group col-md-6">
        <%= f.label :time_slot_id, "Time Slot" %>
        <%= f.select :time_slot_id, 
            options_from_collection_for_select(@time_slots, :id, :formatted_time, @reservation.time_slot_id),
            { prompt: "Select a time" },
            { class: "form-control", required: true, data: { action: "change->reservations#timeSlotChanged", reservations_target: "timeSlotField" } } %>
      </div>
    </div>
    
    <div class="form-group">
      <%= f.label :num_people, "Number of People" %>
      <%= f.number_field :num_people, 
          class: "form-control", 
          min: 1, 
          placeholder: "How many people?",
          required: true,
          data: { action: "change->reservations#numPeopleChanged", reservations_target: "numPeopleField" } %>
    </div>
    
    <% if @reservation.reservation_date.present? && @reservation.time_slot_id.present? %>
      <div class="form-section-title">
        <h3>Choose Your Table</h3>
        <p class="text-muted">Select from available tables that can accommodate your party size</p>
      </div>
      
      <div data-reservations-target="tableSelection">
        <% if @available_tables.present? %>
          <%= render partial: 'table_selection', locals: { available_tables: @available_tables } %>
        <% else %>
          <div class="alert alert-warning">
            <strong>No tables available</strong> for your selected date and time. Please try a different time slot or date.
          </div>
        <% end %>
      </div>
    <% else %>
      <div data-reservations-target="tableSelection">
        <div class="table-selection-placeholder">
          <p class="text-muted">💡 Select a date and time above to see available tables</p>
        </div>
      </div>
    <% end %>
    
    <div class="form-section-title">
      <h3>Contact Information</h3>
      <p class="text-muted">This information will be used to contact you about your reservation</p>
    </div>
    
    <div class="form-group">
      <%= f.label :contact_name, "Full Name" %>
      <%= f.text_field :contact_name, 
          class: "form-control", 
          value: current_user&.name,
          required: true %>
    </div>
    
    <div class="form-row">
  <div class="form-group col-md-6">
    <%= f.label :contact_email, "Email" %>
    <%= f.email_field :contact_email, 
    class: "form-control", 
    value: current_user&.email,
    required: true %>
  </div>
      
  <div class="form-group col-md-6">
    <%= f.label :contact_phone, "Phone Number" %>
    <%= f.text_field :contact_phone, 
    class: "form-control", 
    value: current_user&.phone,
    required: true %>
  </div>
    </div>
    
    <div class="form-actions">
      <%= f.submit "Confirm Reservation", class: "btn btn-primary btn-lg" %>
      <%= link_to "Cancel", reservations_path, class: "btn btn-link" %>
    </div>
  <% end %>
</div>

<div class="info-box">
  <h4>📋 Reservation Policy</h4>
  <ul>
    <li>Reservations must be made at least 2 hours in advance</li>
    <li>You can cancel your reservation up to 2 hours before your scheduled time</li>
    <li>Please arrive on time for your reservation</li>
    <li>If you need to modify your reservation, please cancel and create a new one</li>
  </ul>
</div>
