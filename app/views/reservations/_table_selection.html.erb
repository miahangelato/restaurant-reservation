<% if available_tables.present? %>
  <% time_slot = TimeSlot.find_by(id: reservation.time_slot_id) %>
  <% max_people_allowed = time_slot&.max_people_per_table || 999 %>
  
  <% if reservation.num_people.to_i > max_people_allowed %>
    <div class="alert alert-warning mb-3">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="me-2" viewBox="0 0 16 16">
        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
      </svg>
      <strong>Party size too large:</strong> The selected time slot allows a maximum of <%= max_people_allowed %> people per table. Please select fewer people or choose a different time slot.
    </div>
  <% end %>
  
  <div class="row g-3 mb-3">
<% available_tables.each do |table| %>
  <div class="col-md-4">
    <input type="radio" name="reservation[table_id]" value="<%= table.id %>" id="table_<%= table.id %>" class="btn-check table-radio-input" required>
    <label for="table_<%= table.id %>" class="btn btn-outline-primary w-100 h-100 p-3 text-start" style="transition: color 0.3s;">
      <div class="d-flex align-items-center justify-content-between mb-2">
        <strong class="h5 mb-0">Table <%= table.table_number %></strong>
        <span class="badge bg-success">Available</span>
      </div>
      <div class="text-muted" style="transition: color 0.3s;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
          <path d="M7 14s-1 0-1-1 1-4 5-4 5 3 5 4-1 1-1 1H7zm4-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
          <path fill-rule="evenodd" d="M5.216 14A2.238 2.238 0 0 1 5 13c0-1.355.68-2.75 1.936-3.72A6.325 6.325 0 0 0 5 9c-4 0-5 3-5 4s1 1 1 1h4.216z"/>
          <path d="M4.5 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/>
        </svg>
        Up to <%= table.capacity %> people
      </div>
      <style>
        /* Change text color when hovered or selected */
        label[for="table_<%= table.id %>"]:hover .text-muted,
        input#table_<%= table.id %>:checked + label .text-muted {
          color: white !important;
        }
      </style>
    </label>
  </div>
<% end %>


  </div>

  <div class="alert alert-info d-none align-items-center" role="alert" id="selected-table-display">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="me-3" viewBox="0 0 16 16">
      <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
      <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
    </svg>
    <div>
      <strong>Table Selected:</strong>
      <span id="selected-table-info"></span>
    </div>
  </div>
<% else %>
  <div class="alert alert-warning">
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="me-2" viewBox="0 0 16 16">
      <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
    </svg>
    <strong>No tables available</strong> for your selected date and time. Please try a different time slot or date.
  </div>
<% end %>

<script>
// Update selected table display when radio button changes
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.table-radio-input').forEach(radio => {
    radio.addEventListener('change', function() {
      if (this.checked) {
        const label = document.querySelector(`label[for="${this.id}"]`);
        const tableNumber = label.querySelector('strong').textContent;
        const tableCapacity = label.querySelector('.text-muted').textContent.trim();
        
        const displayElement = document.getElementById('selected-table-display');
        const infoElement = document.getElementById('selected-table-info');
        
        infoElement.innerHTML = `<strong>${tableNumber}</strong> - ${tableCapacity}`;
        displayElement.classList.remove('d-none');
        displayElement.classList.add('d-flex');
      }
    });
  });
});
</script>