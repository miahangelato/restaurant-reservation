<% content_for :title, "Login - Restaurant Reservation System" %>

<div class="auth-container">
  <div class="auth-card">
    <h1>Login</h1>
    <p class="text-muted">Welcome back! Please login to your account.</p>
    
    <%= form_with url: login_path, method: :post, class: "auth-form" do |f| %>
      <div class="form-group">
        <%= f.label :email, "Email Address" %>
        <%= f.email_field :email, class: "form-control", placeholder: "your@email.com", required: true, autofocus: true %>
      </div>
      
      <div class="form-group">
        <%= f.label :password, "Password" %>
        <%= f.password_field :password, class: "form-control", placeholder: "••••••••", required: true %>
      </div>
      
      <div class="form-actions">
        <%= f.submit "Login", class: "btn btn-primary btn-block" %>
      </div>
    <% end %>
    
    <div class="auth-links">
      <p>Don't have an account? <%= link_to "Sign up here", signup_path %></p>
    </div>
  </div>
</div>
