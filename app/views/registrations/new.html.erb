<% content_for :title, "Sign Up - Restaurant Reservation System" %>

<div class="auth-container">
  <div class="auth-card">
    <h1>Sign Up</h1>
    <p class="text-muted">Create an account to start making reservations.</p>
    
    <%= form_with model: @user, url: signup_path, class: "auth-form" do |f| %>
      <% if @user.errors.any? %>
        <div class="alert alert-danger">
          <h4><%= pluralize(@user.errors.count, "error") %> prohibited this account from being created:</h4>
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>
      
      <div class="form-group">
        <%= f.label :name, "Full Name" %>
        <%= f.text_field :name, class: "form-control", placeholder: "John Doe", required: true, autofocus: true %>
      </div>
      
      <div class="form-group">
        <%= f.label :email, "Email Address" %>
        <%= f.email_field :email, class: "form-control", placeholder: "your@email.com", required: true %>
      </div>
      
      <div class="form-group">
        <%= f.label :phone, "Phone Number" %>
        <%= f.text_field :phone, class: "form-control", placeholder: "+1 234 567 8900", required: true %>
      </div>
      
      <div class="form-group">
        <%= f.label :password, "Password" %>
        <%= f.password_field :password, class: "form-control", placeholder: "••••••••", required: true %>
        <small class="form-text">Minimum 6 characters</small>
      </div>
      
      <div class="form-group">
        <%= f.label :password_confirmation, "Confirm Password" %>
        <%= f.password_field :password_confirmation, class: "form-control", placeholder: "••••••••", required: true %>
      </div>
      
      <div class="form-actions">
        <%= f.submit "Create Account", class: "btn btn-primary btn-block" %>
      </div>
    <% end %>
    
    <div class="auth-links">
      <p>Already have an account? <%= link_to "Login here", login_path %></p>
    </div>
  </div>
</div>
