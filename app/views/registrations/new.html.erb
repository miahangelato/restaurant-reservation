<% content_for :title, "Sign Up - Restaurant Reservation System" %>
<% content_for :hide_nav_footer, true %>

<div class="container" style="height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden;">
  <div class="row justify-content-center w-100">
    <div class="col-md-6">
      <div class="card shadow" >
        <div class="card-body p-5">
          <div class="text-center mb-4">
            <h2 class="mb-2">🍽️ Create Account</h2>
            <p class="text-muted">Sign up to start making reservations</p>
          </div>
          
          <%= form_with model: @user, url: signup_path, local: true do |f| %>
            <% if @user.errors.any? %>
              <div class="alert alert-danger">
                <strong><%= pluralize(@user.errors.count, "error") %> prohibited this account from being created:</strong>
                <ul class="mb-0 mt-2">
                  <% @user.errors.full_messages.each do |message| %>
                    <li><%= message %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>
            
            <div class="mb-3">
              <%= f.label :name, "Full Name", class: "form-label" %>
              <%= f.text_field :name, class: "form-control", placeholder: "John Doe", required: true, autofocus: true %>
            </div>
            
            <div class="mb-3">
              <%= f.label :email, "Email Address", class: "form-label" %>
              <%= f.email_field :email, class: "form-control", placeholder: "your@email.com", required: true %>
            </div>
            
            <div class="mb-3">
              <%= f.label :phone, "Phone Number", class: "form-label" %>
              <%= f.text_field :phone, class: "form-control", placeholder: "+1 234 567 8900", required: true %>
            </div>
            
            <div class="mb-3">
              <%= f.label :password, "Password", class: "form-label" %>
              <%= f.password_field :password, class: "form-control", placeholder: "Enter password", required: true %>
              <small class="form-text text-muted">Minimum 6 characters</small>
            </div>
            
            <div class="mb-4">
              <%= f.label :password_confirmation, "Confirm Password", class: "form-label" %>
              <%= f.password_field :password_confirmation, class: "form-control", placeholder: "Confirm password", required: true %>
            </div>
            
            <div class="d-grid">
              <%= f.submit "Create Account", class: "btn btn-primary btn-lg" %>
            </div>
          <% end %>
          
          <hr class="my-4">
          
          <div class="text-center">
            <p class="mb-0">Already have an account? <%= link_to "Login here", login_path, class: "text-decoration-none" %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
