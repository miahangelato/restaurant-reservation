<% content_for :title, "Admin Dashboard - Restaurant Reservation System" %>

<div class="admin-page-header">
  <h1>Dashboard</h1>
  <p class="text-muted">Overview of your restaurant reservations</p>
</div>

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-icon">📊</div>
    <div class="stat-content">
      <h3><%= @total_reservations %></h3>
      <p>Total Reservations</p>
    </div>
  </div>
  
  <div class="stat-card highlight">
    <div class="stat-icon">📅</div>
    <div class="stat-content">
      <h3><%= @today_count %></h3>
      <p>Today's Reservations</p>
    </div>
  </div>
  
  <div class="stat-card">
    <div class="stat-icon">📈</div>
    <div class="stat-content">
      <h3><%= @week_count %></h3>
      <p>This Week</p>
    </div>
  </div>
  
  <div class="stat-card">
    <div class="stat-icon">📆</div>
    <div class="stat-content">
      <h3><%= @month_count %></h3>
      <p>This Month</p>
    </div>
  </div>
</div>

<div class="quick-actions">
  <h3>Quick Actions</h3>
  <div class="actions-grid">
    <%= link_to admin_time_slots_calendar_path, class: "action-card" do %>
      <div class="action-icon">🕒</div>
      <div class="action-content">
        <h4>Time Slots Calendar</h4>
        <p>View and manage time slots availability</p>
      </div>
    <% end %>

    <%= link_to admin_calendar_path, class: "action-card" do %>
      <div class="action-icon">📅</div>
      <div class="action-content">
        <h4>Reservation Calendar</h4>
        <p>View reservations by date</p>
      </div>
    <% end %>

    <%= link_to new_admin_time_slot_path, class: "action-card" do %>
      <div class="action-icon">➕</div>
      <div class="action-content">
        <h4>Add Time Slot</h4>
        <p>Create new time slots</p>
      </div>
    <% end %>

    <%= link_to admin_time_slots_path, class: "action-card" do %>
      <div class="action-icon">⚙️</div>
      <div class="action-content">
        <h4>Manage Time Slots</h4>
        <p>Edit existing time slots</p>
      </div>
    <% end %>
  </div>
</div>

<div class="dashboard-section">
  <div class="section-header">
    <h2>Today's Reservations (<%= Date.today.strftime("%B %d, %Y") %>)</h2>
    <%= link_to "View All", admin_reservations_path(date: Date.today), class: "btn btn-secondary" %>
  </div>
  
  <% if @today_reservations.any? %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Time</th>
            <th>Customer</th>
            <th>Party Size</th>
            <th>Table</th>
            <th>Contact</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% @today_reservations.each do |reservation| %>
            <tr>
              <td><strong><%= reservation.formatted_time %></strong></td>
              <td><%= reservation.user.name %></td>
              <td><%= reservation.num_people %> people</td>
              <td><%= reservation.table ? reservation.table.display_name : 'N/A' %></td>
              <td><%= reservation.contact_phone %></td>
              <td><span class="badge badge-<%= reservation.status %>"><%= reservation.status.titleize %></span></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <p>No reservations for today.</p>
    </div>
  <% end %>
</div>

<div class="dashboard-section">
  <div class="section-header">
    <h2>Upcoming Reservations</h2>
    <%= link_to "View All", admin_reservations_path, class: "btn btn-secondary" %>
  </div>
  
  <% if @upcoming_reservations.any? %>
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Date & Time</th>
            <th>Customer</th>
            <th>Party Size</th>
            <th>Table</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @upcoming_reservations.each do |reservation| %>
            <tr>
              <td>
                <strong><%= reservation.formatted_date %></strong><br>
                <small><%= reservation.formatted_time %></small>
              </td>
              <td><%= reservation.user.name %></td>
              <td><%= reservation.num_people %> people</td>
              <td><%= reservation.table ? reservation.table.display_name : 'N/A' %></td>
              <td><span class="badge badge-<%= reservation.status %>"><%= reservation.status.titleize %></span></td>
              <td>
                <%= link_to "View", admin_reservation_path(reservation), class: "btn btn-sm btn-secondary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <p>No upcoming reservations.</p>
    </div>
  <% end %>
</div>
