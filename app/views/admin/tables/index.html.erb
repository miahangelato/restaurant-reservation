<% content_for :title, "Tables - Admin" %>

<div class="container-fluid px-5 py-4">
  <div class="row">
    <div class="col-12">
      <!-- Page Header -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
          <h1 class="h3 mb-1">Tables Management</h1>
          <p class="text-muted mb-0">Manage your restaurant tables and seating capacity</p>
        </div>
        <div>
          <%= link_to new_admin_table_path, class: "btn btn-primary" do %>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="me-1" viewBox="0 0 16 16">
              <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
            </svg>
            Add New Table
          <% end %>
        </div>
      </div>

      <% if @tables.any? %>
        <div class="card border-0 shadow-sm">
          <div class="card-body p-0">
            <div class="table-responsive">
              <table class="table table-hover mb-0">
                <thead class="table-light">
                  <tr>
                    <th class="border-0">Table Number</th>
                    <th class="border-0">Capacity</th>
                    <th class="border-0">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% @tables.each do |table| %>
                    <tr>
                      <td>
                        <strong>Table <%= table.table_number %></strong>
                      </td>
                      <td>
                        <span class="badge bg-light text-dark"><%= table.capacity %> people</span>
                      </td>
                      <td>
                        <%= link_to "Edit", edit_admin_table_path(table), class: "btn btn-sm btn-outline-primary me-2" %>
                        <%= button_to "Delete", admin_table_path(table), method: :delete,
                            data: { turbo_confirm: "Are you sure? This will affect all reservations using this table." },
                            class: "btn btn-sm btn-outline-danger" %>
                      </td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      <% else %>
        <div class="card border-0 shadow-sm">
          <div class="card-body text-center py-5">
            <div class="text-muted mb-3" style="font-size: 3rem;">🪑</div>
            <h4 class="mb-3">No Tables Configured</h4>
            <p class="text-muted mb-4">Get started by adding your first table to the system.</p>
            <%= link_to "Add Your First Table", new_admin_table_path, class: "btn btn-primary" %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
