<% content_for :title, "Tables - Admin" %>

<div class="admin-page-header">
  <h1>Tables Management</h1>
  <%= link_to "Add New Table", new_admin_table_path, class: "btn btn-primary" %>
</div>

<% if @tables.any? %>
  <div class="table-responsive">
    <table class="data-table">
      <thead>
        <tr>
          <th>Table Number</th>
          <th>Capacity</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @tables.each do |table| %>
          <tr>
            <td><strong>Table <%= table.table_number %></strong></td>
            <td><%= table.capacity %> people</td>
            <td>
              <%= link_to "Edit", edit_admin_table_path(table), class: "btn btn-sm btn-info" %>
              <%= button_to "Delete", admin_table_path(table), method: :delete,
                  data: { turbo_confirm: "Are you sure? This will affect all reservations using this table." },
                  class: "btn btn-sm btn-danger" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty-state">
    <p>No tables configured.</p>
    <%= link_to "Add Your First Table", new_admin_table_path, class: "btn btn-primary" %>
  </div>
<% end %>
